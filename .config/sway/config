# See also:
# <https://wiki.archlinux.org/title/Sway>

include /etc/sway/config-vars.d/*

set $os Mod4
set $fn Mod4+Mod1
set $alt Mod1
set $altgr Mod5
set $menu rofi -show drun -show-icons

# Lifted from <https://gist.github.com/Cardoso1994/80641d652a4adcf6c8f718ebc3770ab9>
# and https://github.com/morhetz/gruvbox
set $bg       #282828
set $fg       #d4be98
set $red      #ea6962
set $orange   #e78a4e
set $green    #a9b665
set $dgreen   #495605
set $blue     #7daea3
set $purple   #d3869b
# set $aqua     #89b482
set $aqua     #689d6a

#       Gruvbox Theme   brdr        bg          text    indictr     chld_brdr
client.focused          $dgreen     #689d6a     #1d2021 $green      #689d6a
client.focused_inactive $bg         $bg         $fg     $green      $green
client.unfocused        $bg         $bg         $fg     $bg         $bg
client.urgent           $red        $red        $fg     $red        $red
client.placeholder      $bg         $bg         $fg     $bg         $bg
client.background       $bg
output * bg #32302f solid_color

default_border normal 1
default_floating_border normal 2
floating_modifier Mod4 normal
focus_wrapping no
font Cascadia Mono NF, FontAwesome 8
gaps inner 0
gaps outer 1
hide_edge_borders smart
smart_borders true
smart_gaps true
title_align left
titlebar_border_thickness 0
titlebar_padding 5 0
# title_window_icon yes # cf <https://github.com/swaywm/sway/issues/4882>

for_window [app_id="org.mozilla.firefox"] border pixel 0

include config.d/*
